# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/accessable_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/accessable_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/accessable_db

# MongoDB Atlas fallback policy: false = fail startup on Atlas connection error; true = allow development fallback to local MongoDB
ALLOW_LOCAL_DB_FALLBACK=false

# JWT Secret Key and Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Google Maps Platform Credentials (Optional - server falls back to verified database if omitted)
# 1. Google Places API (New) Server Key
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# 2. Google Maps JavaScript API Client Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# AI Assessment & Computer Vision (Optional - falls back to robust local heuristic engine if omitted)
# Google Gemini API Key for AI Accessibility Assessments & Multimodal Photo Scanning
GEMINI_API_KEY=your_gemini_api_key_here
