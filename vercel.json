{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "client/"
    },
    "server": {
      "root": "server/",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "server",
        "path": "/api/:path*"
      }
    },
    {
      "source": "/uploads/:path*",
      "destination": {
        "service": "server",
        "path": "/uploads/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
